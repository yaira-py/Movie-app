
import requests
import tkinter as tk
from tkinter import messagebox
import threading

api_key='3b0e709e'

class MovieApp:
    def __init__(self,root):
        self.root=root
        self.root.title('Movie Database')
        self.root.geometry('500x500')
        self.root.configure(bg="#fdf5a7")

        self.tx_lb=tk.Label(self.root,text='Enter Movie Name',bg='#fdf5a7',font=('Arial',12))
        self.tx_lb.pack(pady=(10,0))

        self.frame1=tk.Frame(self.root,bg='#fdf5a7')
        self.frame1.pack(pady=10)

        self.entry=tk.Entry(self.frame1,width=28,font=('Arial',13))
        self.entry.pack(padx=10,side='left',ipady=4)

        self.check_btn=tk.Button(self.frame1,text='Check',font=('Arial',13,'bold'),bg="#f85252",fg='white',
                                 command=self.search)
        self.check_btn.pack(padx=10,side='right')

        self.text_box=tk.Text(self.root,height=40,bg='white',wrap='word',state='disabled')
        self.text_box.pack(pady=10,padx=20)



    def search(self):
        self.text_box.delete(1.0,tk.END)
        self.tx_lb.config(text='wait loading...')

        movie=self.entry.get().strip()
        if not movie:
            messagebox.showinfo('Invalid','Something went wrong')
            return

        url=f'http://www.omdbapi.com/?t={movie}&apiKey={api_key}'
        data= requests.get(url).json()

        self.tx_lb.config(text='Enter movie name')
        
        if data.get('Response')=="false":
            result= 'Could not find the movie'

        else:
            
            result= f""" 🎬{data.get('Title')} ({data.get('Year')})
           ⭐️ Rating: {data.get('imdbRating')} / 10 ({data.get('imdbVotes')} votes)
           🕐 Runtime: {data.get('Runtime')} 
           📅 Release Date: {data.get('Released')}
           💰  Budget: $165,000,000
           💵 Revenue: {data.get('BoxOffice')}
           🎭 Genres: {data.get('Genre')}

           📝 Overview: {data.get('Plot')}
           👥  Top Cast: - {data.get('Actors')}
           🎥 Director: {data.get('Director')}
                """

            self.text_box.config(state='normal')
            self.text_box.delete(1.0,tk.END)
            self.text_box.insert(tk.END,result)
            self.text_box.config(state='disabled')

    

            











if __name__=="__main__":
    window=tk.Tk()
    app= MovieApp(window)
    window.mainloop()
